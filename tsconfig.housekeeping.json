{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "noFallthroughCasesInSwitch": true,
        "types": ["vite/client"],
        "baseUrl": ".",
        "paths": { "@hk/*": ["resources/housekeeping/*"] }
    },
    "include": ["resources/housekeeping"]
}
